{
  "name": "lv1-reaper",
  "version": "2.1.0",
  "description": "Import a Waves LV1 mixer's track list (name, mono/stereo, color) into REAPER",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Malik MALASSIS",
  "private": true,
  "main": "lv1_fetch.js",
  "homepage": "https://github.com/malik-malassis/lv1-to-reaper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malik-malassis/lv1-to-reaper.git"
  },
  "bugs": {
    "url": "https://github.com/malik-malassis/lv1-to-reaper/issues"
  },
  "scripts": {
    "test": "node tools/lint-lua.js && node --test",
    "lint:lua": "node tools/lint-lua.js",
    "scan": "node lv1_fetch.js --scan --verbose",
    "fetch": "node lv1_fetch.js --verbose",
    "mock": "node lv1_fetch.js --mock test/fixtures/lv1_tracks.sample.json --verbose",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {},
  "devDependencies": {
    "luaparse": "^0.3.1"
  }
}
